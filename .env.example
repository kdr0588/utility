# Copy this file to .env and fill it in. .env is in .gitignore. Never commit it.

# Gmail account that sends the rent emails.
# Use a Gmail app password, not your normal password:
# https://myaccount.google.com/apppasswords (needs 2-Step Verification turned on)
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=

# Optional. Defaults to Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# House 58 utility logins (names must match houses.toml)
HOUSE58_GAS_USERNAME=
HOUSE58_GAS_PASSWORD=
HOUSE58_ELECTRICITY_ACCOUNT=
HOUSE58_ELECTRICITY_PASSWORD=

# House 23 utility logins
HOUSE23_GAS_USERNAME=
HOUSE23_GAS_PASSWORD=
HOUSE23_ELECTRICITY_ACCOUNT=
HOUSE23_ELECTRICITY_PASSWORD=
